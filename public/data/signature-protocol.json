{
  "version": "1.0",

  "detectionModel": "weighted-probabilistic-inference",

  "signalTypes": {
    "html": {
      "description": "Matches against raw HTML content",
      "baseReliability": 0.7
    },
    "script": {
      "description": "Matches against loaded JS scripts",
      "baseReliability": 0.85
    },
    "url": {
      "description": "Matches against page URL or asset URLs",
      "baseReliability": 0.9
    },
    "header": {
      "description": "Matches HTTP response headers",
      "baseReliability": 0.95
    },
    "cookie": {
      "description": "Matches browser cookies",
      "baseReliability": 0.9
    }
  },

  "scoringRules": {
    "confidenceFormula": "sum(weight * reliability) / maxPossibleScore",
    "exclusiveSignalBoost": 1.25,
    "multiSignalBonus": 1.1,
    "minimumConfidenceThreshold": 0.35
  },

  "classificationRules": {
    "strongDetection": 0.85,
    "mediumDetection": 0.6,
    "weakDetection": 0.35
  },

  "engineBehavior": {
    "allowPartialMatches": true,
    "preferExclusiveSignals": true,
    "ignoreSingleWeakSignals": true,
    "requireMultiSignalForHighConfidence": true
  },

  "aiInterpretationLayer": {
    "enabled": true,
    "generateInsights": true,
    "generateMigrationRisk": true,
    "generatePerformanceRisk": true,
    "generateAIReadinessScore": true
  }
}
